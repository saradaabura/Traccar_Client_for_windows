<Window x:Class="TraccarClientWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Traccar For Windows (WPF)" Height="550" Width="500" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- タイトル -->
        <TextBlock Grid.Row="0" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"><Run Text="Traccar Client"/><Run Language="ja-jp" Text=" For Windows"/></TextBlock>

        <!-- 設定エリア (Expander) -->
        <Expander Grid.Row="1" Header="設定" FontWeight="Bold" IsExpanded="True" Margin="0,0,0,10">
            <StackPanel Margin="10">
                <TextBlock FontWeight="Normal" Margin="0,0,0,2"><Run Text="Traccar Server URL"/><Run Language="ja-jp" Text=" (ex: http://~:5055)"/></TextBlock>
                <TextBox x:Name="TxtUrl" Margin="0,0,0,8" FontWeight="Normal"/>

                <TextBlock Text="デバイス識別子" FontWeight="Normal" Margin="0,0,0,2"/>
                <TextBox x:Name="TxtDeviceId" Margin="0,0,0,8" FontWeight="Normal"/>

                <TextBlock Text="送信間隔 (秒)" FontWeight="Normal" Margin="0,0,0,2"/>
                <TextBox x:Name="TxtInterval" Margin="0,0,0,8" FontWeight="Normal"/>

                <CheckBox x:Name="ChkAutoStart" Content="アプリ起動時に自動送信を有効化する" FontWeight="Normal" Margin="0,0,0,8"/>

                <Button Content="設定を保存" Click="BtnSaveConfig_Click" HorizontalAlignment="Left" Padding="10,5"/>
            </StackPanel>
        </Expander>

        <!-- 操作ボタンエリア -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnManual" Grid.Column="0" Content="今すぐ送信" Click="BtnManual_Click" Padding="15,8"/>
            <CheckBox x:Name="ChkAutoSend" Grid.Column="2" Content="自動送信を有効化" Checked="ChkAutoSend_Checked" Unchecked="ChkAutoSend_Unchecked" VerticalAlignment="Center"/>
        </Grid>

        <!-- ステータス・ログカードエリア -->
        <Border Grid.Row="3" Background="#FFF5F5F5" BorderBrush="#FFDDDDDD" BorderThickness="1" CornerRadius="4" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="ステータス" FontWeight="Bold"/>
                    <ProgressBar x:Name="StatusProgressBar" Margin="2,2,0,2" Height="10" Width="150" Minimum="0" Maximum="100" />
                    <TextBlock x:Name="TxtBufferCount" Text="未送信データ: 0件" HorizontalAlignment="Right" Foreground="Gray" FontWeight="Bold"/>
                </DockPanel>

                <TextBlock x:Name="TxtStatus" Grid.Row="1" Text="待機中..." Foreground="Blue" FontWeight="Bold" Margin="0,0,0,10"/>

                <TextBox x:Name="TxtLog" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" 
                         Background="White" BorderBrush="#FFCCCCCC" Foreground="#FF333333" 
                         Text="「今すぐ送信」または「自動送信」を開始してください"/>
            </Grid>
        </Border>
    </Grid>
</Window>